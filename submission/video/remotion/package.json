{
  "name": "ruleshift-submission-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/audio.mjs",
    "capture:overview": "node scripts/capture-demo.mjs overview",
    "capture:rehearsal": "node scripts/capture-demo.mjs rehearsal",
    "capture:live": "node scripts/capture-demo.mjs live",
    "capture:codex": "node scripts/capture-codex.mjs",
    "capture:wait": "node scripts/capture-when-ready.mjs",
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "render:demo": "node scripts/render-demo.mjs",
    "verify": "node scripts/verify.mjs",
    "stills": "node scripts/render.mjs --stills",
    "render": "node scripts/audio.mjs && node scripts/render.mjs",
